{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harman.local/schemas/repository-index-v1.schema.json",
  "title": "Harman repository index v1",
  "type": "object",
  "required": ["schemaVersion", "sequence", "generatedAt", "packages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "packages": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["version", "artifact"],
          "properties": {
            "version": { "type": "string" },
            "description": { "type": "string" },
            "dependencies": { "type": "object", "additionalProperties": { "type": "string" } },
            "resources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "type", "path"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*/[A-Za-z0-9._-]+$" },
                  "type": { "type": "string" },
                  "path": { "type": "string" },
                  "displayName": { "type": "string" }
                }
              }
            },
            "dsh": { "type": "string" },
            "platform": { "type": "array", "items": { "type": "string" } },
            "arch": { "type": "array", "items": { "type": "string" } },
            "artifact": {
              "type": "object",
              "required": ["url", "sha256"],
              "properties": {
                "url": { "type": "string" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "signatures": { "$ref": "#/$defs/signatures" }
              }
            }
          }
        }
      }
    },
    "runtimes": {
      "type": "object",
      "properties": {
        "dsh": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["version", "official", "artifact", "executablePath"],
            "properties": {
              "version": { "type": "string" },
              "official": { "const": true },
              "source": { "type": "string" },
              "executablePath": { "type": "string" },
              "launcherArgs": { "type": "array", "items": { "type": "string" } },
              "artifact": {
                "type": "object",
                "required": ["url", "sha256"],
                "properties": {
                  "url": { "type": "string" },
                  "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "signatures": { "$ref": "#/$defs/signatures" }
                }
              }
            }
          }
        }
      }
    },
    "signatures": { "$ref": "#/$defs/signatures" }
  },
  "$defs": {
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["keyId", "algorithm", "signature"],
        "properties": {
          "keyId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "algorithm": { "const": "ed25519" },
          "signature": { "type": "string" }
        }
      }
    }
  }
}
