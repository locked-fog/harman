{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harman.local/schemas/recipe-v1.schema.json",
  "title": "Harman recipe v1",
  "type": "object",
  "required": ["schemaVersion", "name", "version", "source", "build", "outputArtifact"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "sourceDateEpoch": { "type": "integer", "minimum": 0 },
    "source": {
      "type": "object",
      "required": ["type", "url", "sha256"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["npm-tgz", "github-release", "git-archive"] },
        "url": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "build": {
      "type": "object",
      "required": ["commands"],
      "additionalProperties": false,
      "properties": {
        "network": { "type": "boolean", "default": false },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "outputArtifact": { "type": "string", "minLength": 1 }
  }
}
