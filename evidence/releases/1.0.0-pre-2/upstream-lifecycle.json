    "symbols": [
      "PROFILE_ROOT_FILENAME",
      "PROFILE_ROOT_CONFIG",
      "prepareProfile",
      "composeProfile",
      "runProfile"
    ],
    "facts": [
      "PROFILE_ROOT_FILENAME is cordis.yml",
      "prepareProfile rewrites the empty derived root on every profile preparation",
      "composeProfile applies bundle patches, the profile cordis.patch.yml, home patches, and overlays",
      "the root file documents that cordis.patch.yml, not cordis.yml, is the user input"
    ]
  },
  "contract": {
    "profileRoot": {
      "path": "profiles/<profile>/cordis.yml",
      "owner": "DSH",
      "role": "derived profile root",
      "authoritative": false,
      "lifecycle": "rewritten by DSH profile preparation/boot"
    },
    "profilePatch": {
      "path": "profiles/<profile>/cordis.patch.yml",
      "owner": "Harman materialization input",
      "role": "profile-local patch layer",
      "authoritative": true
    },
    "cache": {
      "pathPattern": "<DSH_HOME>/cache/**",
      "owner": "DSH",
      "role": "private rebuildable runtime state",
      "authoritative": false,
      "harmanRematerialization": "preserve when outside .harman-managed.json"
    },
    "harmanView": {
      "managedPaths": [
        ".harman-managed.json",
        "harman.lock.json",
        "profiles/harman"
      ],
      "rule": "replace the managed materialized view atomically; do not copy a stale DSH-derived cordis.yml back into it"
    }
  },
