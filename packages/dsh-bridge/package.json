{
  "name": "@harman/dsh-bridge",
  "version": "1.0.0-pre-1",
  "license": "MIT",
  "description": "Authenticated Harman control plane bridge and DSH Web Settings client",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./remote": { "types": "./lib/typert.remote-client.d.ts", "default": "./lib/typert.remote-client.js" },
    "./typert": { "types": "./lib/typert.host.d.ts", "default": "./lib/typert.host.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./types": { "types": "./lib/types/types.d.ts" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": { "build": "node ../../scripts/build-dsh-bridge.mjs" },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.0.1-rc.1 <0.1.0",
    "@deepseek-ai/dsh-client-locale": ">=0.0.1-rc.1 <0.1.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.0.1-rc.1 <0.1.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.0.1-rc.1 <0.1.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc.1 <0.1.0",
    "@deepseek-ai/dsh-session": ">=0.0.1-rc.1 <0.1.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.6 <0.2.0",
    "react": "^18.2.0"
  },
  "dependencies": { "zod": "^4.4.3" },
  "devDependencies": { "@types/react": "~18.3.1" },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ]
}
